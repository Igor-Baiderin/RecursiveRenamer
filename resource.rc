#include <windows.h>

IDI_APP_ICON ICON "assets/RecursiveRenamer.ico"

1 VERSIONINFO
 FILEVERSION 1,0,0,0
 PRODUCTVERSION 1,0,0,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS__WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904E4"
        BEGIN
            VALUE "CompanyName",      "Igor Baiderin\0"
            VALUE "FileDescription",  "RecursiveRenamer\0"
            VALUE "FileVersion",      "1.0.0.0\0"
            VALUE "InternalName",     "RecursiveRenamer\0"
            VALUE "LegalCopyright",   "Copyright (C) 2026 Igor Baiderin\0"
            VALUE "OriginalFilename", "RecursiveRenamer.exe\0"
            VALUE "ProductName",      "RecursiveRenamer\0"
            VALUE "ProductVersion",   "1.0.0\0"
        END
    END

    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1252
    END
END
